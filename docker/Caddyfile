# Reverse proxy HTTPS (Let's Encrypt automatique pour {$DOMAIN}).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Robots-Tag "noindex, nofollow, noarchive"
		-Server
	}

	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	request_body {
		max_size 20MB
	}

	reverse_proxy app:4321

	# Journaux sans token ni donnée personnelle : liens personnels masqués, secrets des webhooks
	# (?secret=, ?hub.verify_token=) masqués, IP tronquées, cookies retirés.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri multi_regexp {
					regexp ^/(i|api/rsvp)/[^/?]+ /$1/[token]
					regexp ([?&](?:secret|hub\.verify_token)=)[^&]* ${1}[secret]
				}
				request>headers>Cookie delete
				request>headers>Referer delete
				request>headers>Authorization delete
				request>headers>X-Hub-Signature-256 delete
				request>remote_ip ip_mask 16 32
				request>client_ip ip_mask 16 32
				resp_headers>Set-Cookie delete
			}
		}
	}
}
