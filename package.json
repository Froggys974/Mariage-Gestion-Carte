{
  "name": "mariage-rc-gn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site-faire-part de mariage : invitation animée, réponses sur une table 3D, espace des mariés",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-node.mjs",
    "start": "node dist/start.mjs",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-db.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium webkit",
    "db:generate": "drizzle-kit generate",
    "migrate": "node scripts/run.mjs migrate",
    "seed": "node scripts/run.mjs seed",
    "demo-wedding": "node scripts/run.mjs demo-wedding",
    "worker": "node scripts/run.mjs worker",
    "create-admin-hash": "node scripts/run.mjs create-admin-hash",
    "test-mail": "node scripts/run.mjs test-mail",
    "render-names-image": "tsx scripts/render-names-image.ts",
    "compare": "tsx scripts/compare-screens.ts",
    "budget:js": "tsx scripts/check-js-budget.ts",
    "lighthouse": "lhci autorun",
    "lighthouse:proxy": "docker run --rm -d --name mariage-lighthouse-proxy -p 8080:8080 --add-host=host.docker.internal:host-gateway -v ./docker/Caddyfile.lighthouse:/etc/caddy/Caddyfile:ro caddy:2.11-alpine",
    "docker:dev": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:migrate": "docker compose run --rm migrate",
    "docker:seed": "docker compose exec app node scripts/run.mjs seed",
    "docker:test-mail": "docker compose exec app node scripts/run.mjs test-mail",
    "prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "prod:logs": "docker compose -f docker-compose.prod.yml logs -f --tail=200",
    "prod:test-mail": "docker compose -f docker-compose.prod.yml exec app node scripts/run.mjs test-mail",
    "prod:create-admin-hash": "docker compose -f docker-compose.prod.yml run --rm --no-deps app node scripts/run.mjs create-admin-hash",
    "backup": "docker compose -f docker-compose.prod.yml exec backup sh /scripts/backup.sh",
    "restore": "docker compose -f docker-compose.prod.yml stop app worker && docker compose -f docker-compose.prod.yml exec backup sh /scripts/restore.sh",
    "backups:list": "docker compose -f docker-compose.prod.yml exec backup ls -lh /backups",
    "prepare": "husky",
    "purge": "node scripts/run.mjs purge",
    "restore:start": "docker compose -f docker-compose.prod.yml start app worker"
  },
  "dependencies": {
    "@astrojs/node": "11.1.11",
    "@astrojs/preact": "6.1.2",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/pinyon-script": "5.3.0",
    "@fontsource/spline-sans": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "astro": "7.4.7",
    "drizzle-orm": "0.45.4",
    "nodemailer": "10.3.1",
    "pino": "10.4.0",
    "postgres": "4.1.0",
    "preact": "11.2.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
