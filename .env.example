# =============================================================================
#  Faire-part de mariage — modèle de configuration
#  Copiez ce fichier en `.env` puis remplissez les valeurs.
#  Le guide pas à pas est dans doc/CONFIGURATION.md (tableau de toutes les variables).
#  ⚠ Ne commitez JAMAIS le fichier .env (il est dans .gitignore).
# =============================================================================

# ---------------------------------------------------------------------------
#  Général
# ---------------------------------------------------------------------------
# production sur le serveur ; development en local
NODE_ENV=production
# Adresse publique du site, sans « / » final. Sert à fabriquer les liens personnels.
PUBLIC_URL=https://mariage.example.re
# Nom de domaine servi par Caddy (certificat HTTPS Let's Encrypt automatique)
DOMAIN=mariage.example.re
# Email de contact pour Let's Encrypt (alertes d'expiration du certificat)
ACME_EMAIL=vous@example.re
# Sur le serveur uniquement : toutes les commandes « docker compose » visent la prod
COMPOSE_FILE=docker-compose.prod.yml
# Secret aléatoire d'au moins 32 caractères (openssl rand -base64 32)
SESSION_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire
# true derrière Caddy : l'IP du visiteur est lue dans X-Forwarded-For (limites anti-abus)
TRUST_PROXY=true
# fatal | error | warn | info | debug
LOG_LEVEL=info
# Fuseau horaire (heures d'envoi, sauvegardes)
TZ=Indian/Reunion

# ---------------------------------------------------------------------------
#  Base de données PostgreSQL 18
# ---------------------------------------------------------------------------
POSTGRES_USER=mariage
# Lettres et chiffres uniquement (openssl rand -hex 24)
POSTGRES_PASSWORD=remplacez-moi
POSTGRES_DB=mariage
# En production, docker-compose.prod.yml construit l'URL à partir des 3 lignes ci-dessus.
# En local hors Docker : postgres://mariage:mariage@localhost:5434/mariage
DATABASE_URL=postgres://mariage:remplacez-moi@db:5432/mariage

# ---------------------------------------------------------------------------
#  Espace des mariés (admin)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=vous@example.re
# Généré par : pnpm create-admin-hash   (gardez les guillemets simples)
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$remplacez$moi'
# Second admin facultatif (les deux lignes ensemble, ou aucune)
ADMIN2_EMAIL=
ADMIN2_PASSWORD_HASH=

# ---------------------------------------------------------------------------
#  Emails (SMTP — Brevo, Resend, OVH, Gmail Workspace…)
# ---------------------------------------------------------------------------
# smtp = envoi réel ; fake = aucun envoi (tests)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
# 587 (STARTTLS) ou 465 (TLS direct)
SMTP_PORT=587
# true pour le port 465, sinon laisser vide
SMTP_SECURE=
SMTP_USER=identifiant-smtp
SMTP_PASS=cle-smtp
# Expéditeur affiché. L'adresse doit appartenir au domaine vérifié chez le fournisseur.
MAIL_FROM="Prénom & Prénom <faire-part@mariage.example.re>"
# Adresse où arrivent les réponses des invités (facultatif)
MAIL_REPLY_TO=
# Secret partagé pour le webhook de suivi Brevo : /api/webhooks/email?secret=…
EMAIL_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
#  WhatsApp Cloud API (Meta)
# ---------------------------------------------------------------------------
# cloud = API Meta ; fake = simulé (les messages vont dans les journaux)
WHATSAPP_PROVIDER=fake
# developers.facebook.com > votre app > WhatsApp > Configuration de l'API
WHATSAPP_PHONE_NUMBER_ID=
# Token PERMANENT d'un utilisateur système (Business Manager)
WHATSAPP_TOKEN=
# Modèle approuvé avec {{1}} = prénom et {{2}} = lien
WHATSAPP_TEMPLATE_NAME=faire_part_invitation
WHATSAPP_TEMPLATE_LANG=fr
# Modèle de catégorie « Authentification » pour le code à 6 chiffres
WHATSAPP_OTP_TEMPLATE_NAME=code_verification
# Paramètres de l'app > Général > Clé secrète (vérifie la signature des webhooks)
WHATSAPP_APP_SECRET=
# Chaîne que vous inventez, recopiée dans la configuration du webhook Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v26.0

# ---------------------------------------------------------------------------
#  Fichiers envoyés (photo de la carte)
# ---------------------------------------------------------------------------
UPLOAD_DIR=/data/uploads

# ---------------------------------------------------------------------------
#  File d'envoi
# ---------------------------------------------------------------------------
# Délai entre deux envois groupés, en millisecondes (1000 = 1 envoi par seconde)
WORKER_SEND_INTERVAL_MS=1000

# ---------------------------------------------------------------------------
#  Sauvegardes (service backup)
# ---------------------------------------------------------------------------
# Nombre de sauvegardes conservées
BACKUP_KEEP=14
# Heure de la sauvegarde nocturne (format cron)
BACKUP_CRON=0 3 * * *
