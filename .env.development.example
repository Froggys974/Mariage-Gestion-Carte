# =============================================================================
#  Configuration de DÉVELOPPEMENT (sur votre PC) — prête à l'emploi.
#  Copier en `.env` :  Copy-Item .env.development.example .env   (PowerShell)
#  Aucun vrai secret ici : ces valeurs ne servent qu'en local. Pour la production,
#  partir de .env.example et suivre doc/CONFIGURATION.md.
# =============================================================================
NODE_ENV=development
PUBLIC_URL=http://localhost:4321
SESSION_SECRET=dev-uniquement-dev-uniquement-dev-uniquement-0123
TRUST_PROXY=false
LOG_LEVEL=info
TZ=Indian/Reunion

# Base PostgreSQL du docker-compose de dev (port 5434 sur le PC, pour ne pas gêner un PostgreSQL local).
# Dans Docker, docker-compose.yml remplace DATABASE_URL par l'adresse interne.
POSTGRES_USER=mariage
POSTGRES_PASSWORD=mariage
POSTGRES_DB=mariage
DATABASE_URL=postgres://mariage:mariage@localhost:5434/mariage

# Espace des mariés en local : maries@mariage.test / mariage-dev-2026
ADMIN_EMAIL=maries@mariage.test
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$5O72idxnErqv9hXyXNqXRA$hV7/GwoNHXVRtMwWYAn2VY7cH5L97qlhU8xpdBNB6oE'
ADMIN2_EMAIL=
ADMIN2_PASSWORD_HASH=

# Emails : Mailpit les intercepte tous (http://localhost:8025). Dans Docker, SMTP_HOST devient « mailpit ».
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Faire-part <faire-part@mariage.test>"
MAIL_REPLY_TO=
EMAIL_WEBHOOK_SECRET=

# WhatsApp simulé : les messages sont écrits dans les journaux du worker
WHATSAPP_PROVIDER=fake

UPLOAD_DIR=./data/uploads
WORKER_SEND_INTERVAL_MS=1000
